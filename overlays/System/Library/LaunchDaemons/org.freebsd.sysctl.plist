<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  org.freebsd.sysctl.plist

  Applies /etc/sysctl.conf at boot. Replaces conventional rc.d/sysctl.

  On a default live ISO /etc/sysctl.conf is comment-only, so this is a
  near-no-op. Shipped so future overlays adding kernel-tunable knobs
  (net.inet.ip.forwarding, kern.ipc.somaxconn, etc.) take effect.

  /etc/sysctl.conf ships in base.txz (comment-only by default) so
  sysctl -f against it is a safe no-op even with no overlays. No
  /bin/sh wrapper needed.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>org.freebsd.sysctl</string>
    <key>ProgramArguments</key>
    <array>
        <string>/sbin/sysctl</string>
        <string>-f</string>
        <string>/etc/sysctl.conf</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <false/>
</dict>
</plist>
