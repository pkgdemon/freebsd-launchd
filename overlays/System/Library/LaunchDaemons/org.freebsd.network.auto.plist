<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  org.freebsd.network.auto.plist

  Boot-time auto-networking. Invokes /usr/libexec/launchd-network-auto,
  which iterates plugged ethernet interfaces, brings each up with IPv6
  RA acceptance, kicks off background DHCP, and execs rtsold for IPv6
  RS handling. See the script for the full rc.conf-equivalent mapping.

  RunAtLoad fires this once at boot. KeepAlive=false: dhclient -b and
  rtsold are themselves long-running; we don't want launchd to respawn
  the bootstrap script when those finish detaching.

  Per-interface user overrides take precedence: drop a plist named
  org.freebsd.netif.<iface>.plist or org.freebsd.dhclient.<iface>.plist
  into /Local/Library/LaunchDaemons/ and the auto script will skip that
  interface.

  To disable auto-networking entirely, drop a same-named plist into
  /Local/Library/LaunchDaemons/ that does nothing — /Local/Library
  scans win over /System/Library by label-collision rules.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>org.freebsd.network.auto</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/libexec/launchd-network-auto</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <false/>
</dict>
</plist>
