<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  org.freebsd.netconfigd.plist

  Phase 1 netconfigd: enumerates ethernet interfaces at boot, brings each
  up, kicks off `dhclient -b -n` per-iface, exec's `rtsold -a` for IPv6
  router solicitation. Apple-shaped configd port; replaces the
  shell-script auto-network plist we drafted in Phase 3 work and removed
  on agreement that configd would absorb that role.

  RunAtLoad fires once at boot. KeepAlive=true so launchd respawns
  netconfigd if it crashes — though in Phase 1 the daemon mostly sits in
  dispatch_main() after spawning subprocesses, so crashes should be rare.

  Phase 2 will add PF_ROUTE event source for hot-plug interfaces and a
  vnode source on /Local/Library/Preferences/Network.plist for live
  config reload. Phase 3 adds the Distributed Objects server (will need
  a Sockets= key here for the AF_UNIX listener at /var/run/netconfigd.sock).
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>org.freebsd.netconfigd</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/libexec/netconfigd</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
</dict>
</plist>
