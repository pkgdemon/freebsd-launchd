<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  org.freebsd.varrun.plist

  Defensive one-shot: creates /var/run, /var/log, ensures /tmp has the
  sticky bit, touches /var/log/messages so syslogd has somewhere to
  write. Replaces the conventional rc.d/var + rc.d/cleanvar pair.

  On our live ISO, /var/* exists in the unionfs lower (from base.txz),
  so this is mostly a no-op. Keeping the plist explicit so an
  alternative boot configuration (smaller rootfs, different overlay)
  doesn't silently drop these prerequisites.

  RunAtLoad=true, KeepAlive=false, LaunchOnlyOnce-style: fires once
  early at boot and is done.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>org.freebsd.varrun</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>mkdir -p /var/run /var/log /var/spool /var/empty &amp;&amp; chmod 1777 /tmp &amp;&amp; touch /var/log/messages /var/log/auth.log /var/log/maillog</string>
    </array>
    <!-- PID 1 is exec'd by the kernel with no PATH; launchd inherits the
         empty environment and its children (this /bin/sh) see no PATH
         either. Without an explicit PATH, mkdir/chmod/touch lookups fail
         and the shell exits 127. Set a reasonable default. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/sbin:/bin:/usr/sbin:/usr/bin</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <false/>
</dict>
</plist>
