<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  radeonkms.kext — older AMD GPU (TeraScale 2/3, GCN 1.0/1.2) personality.

  Driven by drm-latest-kmod's radeonkms.ko. Covers HD 5000 (Evergreen),
  HD 6000 (Northern Islands), HD 7000 (Southern Islands / GCN 1.0).
  GCN 1.1+ goes to amdgpu.kext. Trimmed to common consumer cards;
  enthusiast/workstation IDs deliberately omitted to keep the list
  manageable.
-->
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>org.freebsd.kext.radeonkms</string>
    <key>CFBundleExecutable</key>
    <string>radeonkms</string>
    <key>OSBundleRequired</key>
    <string>Graphics</string>

    <key>IOKitPersonalities</key>
    <dict>
        <key>RadeonLegacyGraphics</key>
        <dict>
            <key>IOMatchCategory</key>
            <string>PCI</string>
            <key>IOPCIMatch</key>
            <array>
                <!-- HD 5000 (Evergreen / TeraScale 2) -->
                <string>0x1002:0x6898</string>  <!-- HD 5870 -->
                <string>0x1002:0x68B8</string>  <!-- HD 5770 -->
                <string>0x1002:0x68D8</string>  <!-- HD 5670 -->
                <string>0x1002:0x68DA</string>  <!-- HD 5570 -->
                <string>0x1002:0x68F9</string>  <!-- HD 5450 -->

                <!-- HD 6000 (Northern Islands / TeraScale 3) -->
                <string>0x1002:0x6738</string>  <!-- HD 6870 -->
                <string>0x1002:0x6739</string>  <!-- HD 6850 -->
                <string>0x1002:0x6718</string>  <!-- HD 6970 -->
                <string>0x1002:0x6719</string>  <!-- HD 6950 -->
                <string>0x1002:0x6758</string>  <!-- HD 6670 -->
                <string>0x1002:0x6759</string>  <!-- HD 6570 -->
                <string>0x1002:0x6779</string>  <!-- HD 6450 -->

                <!-- HD 7000 (Southern Islands / GCN 1.0) -->
                <string>0x1002:0x6798</string>  <!-- HD 7970 -->
                <string>0x1002:0x6818</string>  <!-- HD 7870 -->
                <string>0x1002:0x6819</string>  <!-- HD 7850 -->
                <string>0x1002:0x683F</string>  <!-- HD 7750 -->
                <string>0x1002:0x683D</string>  <!-- HD 7770 -->

                <!-- R7/R9 200/300 series (Sea Islands / GCN 1.1, partial) -->
                <string>0x1002:0x67B0</string>  <!-- R9 290X -->
                <string>0x1002:0x67B1</string>  <!-- R9 290 -->
                <string>0x1002:0x6810</string>  <!-- R9 270X -->
                <string>0x1002:0x6811</string>  <!-- R9 270 -->
            </array>
            <key>IOProbeScore</key>
            <integer>150</integer>
        </dict>
    </dict>
</dict>
</plist>
