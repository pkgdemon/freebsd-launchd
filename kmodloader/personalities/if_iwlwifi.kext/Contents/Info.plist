<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  if_iwlwifi.kext — Intel modern WiFi (AC 8xxx/9xxx, AX 1xx/2xx, BE 2xx).

  Driven by FreeBSD's iwlwifi LinuxKPI port; kld is if_iwlwifi.ko.
  Firmware blobs ship in wifi-firmware-iwlwifi-kmod (separate pkg).
  Older Intel WiFi (Centrino / 4965 / AGN / 7xxx-8xxx era) belongs to
  iwm or iwn — separate personalities can be added if anyone tests on
  those. Modern laptops 2018+ are essentially all iwlwifi.

  Note: netconfigd's auto-DHCP path filters wlan* prefixes. Loading
  the driver here makes the device appear; the user still needs an
  explicit wpa_supplicant + dhclient pair to associate and get a
  lease. That's a separate Phase / outside kmodloader's scope.
-->
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>org.freebsd.kext.if_iwlwifi</string>
    <key>CFBundleExecutable</key>
    <string>if_iwlwifi</string>
    <key>OSBundleRequired</key>
    <string>Network</string>

    <key>IOKitPersonalities</key>
    <dict>
        <key>IntelModernWiFi</key>
        <dict>
            <key>IOMatchCategory</key>
            <string>PCI</string>
            <key>IOPCIMatch</key>
            <array>
                <!-- AC 8260 / 8265 (Skylake/Kaby Lake era) -->
                <string>0x8086:0x24F3</string>
                <string>0x8086:0x24FD</string>
                <string>0x8086:0x24FB</string>

                <!-- AC 9560/9462/9461/9260 (Whiskey/Ice/Comet Lake) -->
                <string>0x8086:0x2526</string>
                <string>0x8086:0x9DF0</string>
                <string>0x8086:0x31DC</string>
                <string>0x8086:0x34F0</string>

                <!-- AX 200 (Wi-Fi 6, Tiger Lake-era discrete) -->
                <string>0x8086:0x2723</string>

                <!-- AX 201 (CNVi, integrated Comet/Tiger/Alder Lake) -->
                <string>0x8086:0x02F0</string>
                <string>0x8086:0x06F0</string>
                <string>0x8086:0xA0F0</string>
                <string>0x8086:0x4DF0</string>

                <!-- AX 210 / AX 211 (Wi-Fi 6E) -->
                <string>0x8086:0x2725</string>
                <string>0x8086:0x2726</string>
                <string>0x8086:0x51F0</string>
                <string>0x8086:0x51F1</string>
                <string>0x8086:0x54F0</string>

                <!-- Killer AX1675/AX1690 (rebadged AX211) -->
                <string>0x8086:0x272B</string>

                <!-- BE 200/201 (Wi-Fi 7, Meteor Lake / Lunar Lake) -->
                <string>0x8086:0x7AF0</string>
                <string>0x8086:0x7E40</string>
            </array>
            <key>IOProbeScore</key>
            <integer>200</integer>
        </dict>
    </dict>
</dict>
</plist>
