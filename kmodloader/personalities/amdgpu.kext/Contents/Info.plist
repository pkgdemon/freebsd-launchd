<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  amdgpu.kext — modern AMD GPU (GCN 1.1+ / GFX6+) personality.

  Driven by drm-latest-kmod's amdgpu.ko. Covers Polaris (RX 400/500),
  Vega 10/20, Navi 10/14 (RX 5000), Navi 21/22/23/24 (RX 6000), and
  Navi 31/32/33 (RX 7000). Pre-GCN-1.1 cards are radeonkms.kext's
  job. List is consumer-card-focused, not exhaustive.
-->
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>org.freebsd.kext.amdgpu</string>
    <key>CFBundleExecutable</key>
    <string>amdgpu</string>
    <key>OSBundleRequired</key>
    <string>Graphics</string>

    <key>IOKitPersonalities</key>
    <dict>
        <key>AMDGraphics</key>
        <dict>
            <key>IOMatchCategory</key>
            <string>PCI</string>
            <key>IOPCIMatch</key>
            <array>
                <!-- Polaris 10/11 (RX 400/500 series) -->
                <string>0x1002:0x67DF</string>  <!-- RX 480/580/570/470 -->
                <string>0x1002:0x67EF</string>  <!-- RX 460/560 -->
                <string>0x1002:0x67FF</string>  <!-- RX 550/640 -->
                <string>0x1002:0x67E0</string>  <!-- FirePro Polaris11 -->
                <string>0x1002:0x67E3</string>  <!-- E9260 -->
                <string>0x1002:0x67C0</string>  <!-- Radeon Pro WX 7100 -->

                <!-- Vega 10 -->
                <string>0x1002:0x687F</string>  <!-- Vega 56/64 -->
                <string>0x1002:0x6863</string>  <!-- Vega Frontier Edition -->
                <string>0x1002:0x6867</string>  <!-- Vega 56 mobile -->
                <string>0x1002:0x686C</string>  <!-- Vega FE -->
                <string>0x1002:0x6860</string>  <!-- Vega WX -->

                <!-- Vega 20 -->
                <string>0x1002:0x66AF</string>  <!-- Radeon VII -->

                <!-- Navi 10 (RX 5700) -->
                <string>0x1002:0x731F</string>  <!-- RX 5700 / 5700 XT -->
                <string>0x1002:0x7310</string>  <!-- Pro W5700 -->

                <!-- Navi 14 (RX 5500) -->
                <string>0x1002:0x7340</string>  <!-- RX 5500 / 5500 XT -->
                <string>0x1002:0x7341</string>  <!-- Pro W5500 -->
                <string>0x1002:0x7347</string>  <!-- RX 5300 -->

                <!-- Navi 21 (RX 6800/6900) -->
                <string>0x1002:0x73BF</string>  <!-- RX 6800/6800XT/6900XT/6950XT -->
                <string>0x1002:0x73A2</string>  <!-- Pro W6900X -->

                <!-- Navi 22 (RX 6700) -->
                <string>0x1002:0x73DF</string>  <!-- RX 6700 / 6700 XT / 6750 XT -->

                <!-- Navi 23 (RX 6600) -->
                <string>0x1002:0x73FF</string>  <!-- RX 6600 / 6600 XT / 6650 XT -->

                <!-- Navi 24 (RX 6400/6500) -->
                <string>0x1002:0x743F</string>  <!-- RX 6400 / 6500 XT -->

                <!-- Navi 31 (RX 7900) -->
                <string>0x1002:0x744C</string>  <!-- RX 7900 XTX / XT / GRE -->
                <string>0x1002:0x745E</string>  <!-- Pro W7900 -->

                <!-- Navi 32 (RX 7700/7800) -->
                <string>0x1002:0x7480</string>  <!-- RX 7700 XT / 7800 XT -->

                <!-- Navi 33 (RX 7600) -->
                <string>0x1002:0x7470</string>  <!-- RX 7600 / 7600 XT -->
            </array>
            <key>IOProbeScore</key>
            <integer>200</integer>
        </dict>
    </dict>
</dict>
</plist>
